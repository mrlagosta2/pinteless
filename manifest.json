{
  "manifest_version": 3,
  "name": "Pinteless",
  "version": "1.3.0",
  "description": "Declutter Pinterest: just the images, in justified rows that fill the screen without stretching. Save to a board with one click.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Pinteless",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.com.br/*",
        "*://*.pinterest.pt/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.com.au/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.com.br/*",
        "*://*.pinterest.pt/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.com.au/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pinteless@mrlagosta2",
      "strict_min_version": "128.0"
    }
  }
}